# KloxoNext panel web server (private nginx instance)
#
# Generated by init/changeport.php from init/kloxo-nginx.conf.base
# (create init/custom.kloxo-nginx.conf.base to customize).
#
# Panel code runs in the 'kloxo-php' php-fpm (root, PHP __panel_php__).
# Third-party apps (phpMyAdmin, ...) run in 'kloxo-apps' php-fpm
# (lxlabs user, newest PHP installed on the server).

user lxlabs lxlabs;
worker_processes auto;
pid /usr/local/lxlabs/kloxo/init/kloxo-nginx.pid;
error_log /usr/local/lxlabs/kloxo/log/nginx-error.log warn;

events {
	worker_connections 1024;
}

http {
	include /etc/nginx/mime.types;
	default_type application/octet-stream;

	access_log /usr/local/lxlabs/kloxo/log/nginx-access.log;

	sendfile on;
	tcp_nopush on;
	keepalive_timeout 65;
	server_tokens off;

	client_max_body_size 2000m;
	client_body_temp_path /usr/local/lxlabs/kloxo/init/tmp/body;
	fastcgi_temp_path /usr/local/lxlabs/kloxo/init/tmp/fastcgi;
	proxy_temp_path /usr/local/lxlabs/kloxo/init/tmp/proxy;
	uwsgi_temp_path /usr/local/lxlabs/kloxo/init/tmp/uwsgi;
	scgi_temp_path /usr/local/lxlabs/kloxo/init/tmp/scgi;

	gzip on;
	gzip_comp_level 5;
	gzip_types text/css application/javascript application/json image/svg+xml text/plain text/xml;

	map $http_upgrade $connection_upgrade {
		default upgrade;
		''      close;
	}

	upstream kloxo_panel {
		server unix:/usr/local/lxlabs/kloxo/init/kloxo-phpcgi.sock;
	}

	upstream kloxo_apps {
		server unix:/usr/local/lxlabs/kloxo/init/kloxo-apps.sock;
	}

	server {
		listen __nonssl_port__ default_server;
		listen [::]:__nonssl_port__ default_server;
		listen __ssl_port__ ssl __http2_listen__default_server;
		listen [::]:__ssl_port__ ssl __http2_listen__default_server;
		__http2_directive__

		server_name _;

		# program.pem holds key + certificate (+ chain), managed by fixssl / panel SSL
		ssl_certificate     /usr/local/lxlabs/kloxo/etc/program.pem;
		ssl_certificate_key /usr/local/lxlabs/kloxo/etc/program.pem;
		ssl_protocols TLSv1.2 TLSv1.3;
		ssl_prefer_server_ciphers off;
		ssl_session_cache shared:kloxo_ssl:10m;

		root /usr/local/lxlabs/kloxo/httpdocs;
		index index.php index.html index.htm;

		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "SAMEORIGIN" always;
		add_header Referrer-Policy "same-origin" always;
		add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

		# block shellshock / httpoxy (former Hiawatha UrlToolkit rules)
		if ($http_user_agent ~ "\(\)\s*\{") { return 403; }
		if ($http_referer ~ "\(\)\s*\{") { return 403; }
		fastcgi_param HTTP_PROXY "";

		error_page 401 /error/401.html;
		error_page 403 /error/403.html;
		error_page 404 /theme/lbin/sitepreview.php;
		error_page 501 /error/501.html;
		error_page 503 /error/503.html;

		location ^~ /.well-known/acme-challenge/ {
			alias /var/run/acme/acme-challenge/;
			default_type text/plain;
		}

		# never expose internal data
		location ~ /\.(?!well-known) { deny all; }
		location ~* \.(inc|sql|log|bak|db|pass|ini)$ { deny all; }

		location ~* \.(css|js|gif|ico|jpe?g|png|svg|webp|woff2?|ttf|otf|eot|map)$ {
			expires 7d;
			access_log off;
			try_files $uri =404;
		}

		# Third-party applications - newest PHP, unprivileged user
		location ^~ /thirdparty/ {
			location ~ \.php(/|$) {
				fastcgi_split_path_info ^(.+?\.php)(/.*)$;
				try_files $fastcgi_script_name =404;
				include /etc/nginx/fastcgi_params;
				fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
				fastcgi_param PATH_INFO $fastcgi_path_info;
				fastcgi_param HTTPS $https if_not_empty;
				fastcgi_param HTTP_SCHEME $scheme;
				fastcgi_read_timeout 3600;
				fastcgi_pass kloxo_apps;
			}
		}

		location ~ \.php(/|$) {
			fastcgi_split_path_info ^(.+?\.php)(/.*)$;
			try_files $fastcgi_script_name =404;
			include /etc/nginx/fastcgi_params;
			fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
			fastcgi_param PATH_INFO $fastcgi_path_info;
			fastcgi_param HTTPS $https if_not_empty;
			fastcgi_param HTTP_SCHEME $scheme;   # set by Hiawatha, used by redirect.php
			fastcgi_read_timeout 3600;
			fastcgi_buffers 16 32k;
			fastcgi_buffer_size 64k;
			fastcgi_pass kloxo_panel;
		}

		location / {
			try_files $uri $uri/ =404;
		}
	}
}
