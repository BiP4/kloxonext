# It's not recommended to modify this file in-place, because it will be
# overwritten during package upgrades.

# To alter the FPM environment, drop a file with the suffix
# .conf in /etc/systemd/system/php-fpm.service.d, with
#     [Service]
#     Environment=FOO=bar

[Unit]
Description=The PHP FastCGI Process Manager
After=syslog.target network.target

[Service]
Type=notify
RuntimeDirectory=php-fpm
RuntimeDirectoryPreserve=yes
PIDFile=/run/php-fpm/php-fpm.pid
ExecStartPre=/bin/sh -c 'rm -f /opt/configs/php-fpm/sock/php-*.sock'
ExecStart=/usr/local/lxlabs/kloxo/init/php-branch-fpm -y /opt/configs/php-fpm/conf/php/php-fpm.conf --nodaemonize
ExecReload=/bin/kill -USR2 $MAINPID
ExecStop=/bin/kill -s QUIT $MAINPID
PrivateTmp=true

[Install]
WantedBy=multi-user.target

