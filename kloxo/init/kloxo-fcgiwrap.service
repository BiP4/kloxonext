[Unit]
Description=KloxoNext CGI gateway (fcgiwrap) for AWStats and cgi-bin under nginx/hiawatha
Documentation=https://github.com/BiP4/kloxonext
After=network.target

[Service]
Type=simple
User=apache
Group=apache
UMask=0000
RuntimeDirectory=kloxo-fcgiwrap
RuntimeDirectoryPreserve=yes
ExecStartPre=/bin/rm -f /run/kloxo-fcgiwrap/fcgiwrap.sock
ExecStart=/usr/sbin/fcgiwrap -c 4 -s unix:/run/kloxo-fcgiwrap/fcgiwrap.sock
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
