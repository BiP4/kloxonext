[Unit]
Description=KloxoNext backend (applies queued restarts, background jobs)
Documentation=https://github.com/BiP4/kloxonext
After=network.target remote-fs.target nss-lookup.target mariadb.service

[Service]
Type=simple
WorkingDirectory=/usr/local/lxlabs/kloxo/httpdocs
ExecStart=/bin/bash /usr/local/lxlabs/kloxo/sbin/kloxo-wrapper.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
