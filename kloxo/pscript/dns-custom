#!/bin/bash
[ -z "$BASH_VERSION" ] && exec /bin/bash "$0" "$@"
#
#    KloxoNext - permanent custom DNS zones (Admin > Server > Custom DNS Zones),
#    e.g. reverse zones with $GENERATE written by hand.
#
#    The zones are kept in etc/conf/dns-custom/<zone>.zone (never touched by
#    updates, cleanup or the DNS rebuild) and served by BIND from
#    /opt/configs/nsd/conf/custom, included through named.custom.conf.
#
#      dns-custom list                     zone names
#      dns-custom check <zone> <file>      named-checkzone (exit 0 = valid)
#      dns-custom save <zone> <file>       validate, store, apply
#      dns-custom delete <zone>            remove, apply
#      dns-custom apply [--no-reload]      re-render BIND config from the stored zones
#

KLOXO_PATH="${KLOXO_PATH:-/usr/local/lxlabs/kloxo}"
STORE="${KLOXO_PATH}/etc/conf/dns-custom"
ZDIR="/opt/configs/nsd/conf/custom"
INC="/opt/configs/bind/conf/defaults/named.custom.conf"

die() { echo "ERROR=$*" ; exit 1 ; }

valid_zone() {
	# reverse zones only: they never clash with the domains the panel manages
	[[ "$1" =~ ^([0-9a-fA-F]+(-[0-9]+)?\.)+(in-addr|ip6)\.arpa$ ]]
}

named_user() { getent passwd named >/dev/null && echo named || echo bind ; }

cmd_list() {
	local f
	for f in "${STORE}"/*.zone ; do
		[ -f "${f}" ] && basename "${f}" .zone
	done
}

cmd_check() {
	valid_zone "$1" || die "zone name must be a reverse zone (e.g. 207.180.81.in-addr.arpa)"
	[ -f "$2" ] || die "no zone file"
	command -v named-checkzone >/dev/null 2>&1 || die "named-checkzone not found (BIND is required)"

	if named-checkzone -q -i local "$1" "$2" >/dev/null 2>&1 ; then
		echo "OK=$(named-checkzone -i local "$1" "$2" 2>&1 | tail -1)"
	else
		die "$(named-checkzone -i local "$1" "$2" 2>&1 | grep -v '^zone .*: loaded serial' | head -5 | tr '\n' ' ')"
	fi
}

cmd_apply() {
	local z u str=""

	mkdir -p "${STORE}" "${ZDIR}"
	chmod 700 "${STORE}"
	u="$(named_user)"

	# zone files: exactly the stored ones
	for z in "${ZDIR}"/* ; do
		[ -f "${z}" ] || continue
		[ -f "${STORE}/$(basename "${z}").zone" ] || rm -f "${z}"
	done

	for z in $(cmd_list) ; do
		valid_zone "${z}" || continue
		cp -f "${STORE}/${z}.zone" "${ZDIR}/${z}"
		chown "${u}" "${ZDIR}/${z}" 2>/dev/null
		chmod 644 "${ZDIR}/${z}"

		str="${str}zone \"${z}\" in {\n    type master;\n    file \"custom/${z}\";\n};\n\n"
	done

	chown "${u}" "${ZDIR}" 2>/dev/null
	printf "// KloxoNext - custom zones (etc/conf/dns-custom), do not edit\n\n${str}" > "${INC}"

	# a zone defined here wins over the same name generated by Kloxo's reverse DNS
	if [ -f /opt/configs/bind/conf/defaults/named.reverse.conf ] ; then
		for z in $(cmd_list) ; do
			sed -i "/^zone \"${z//./\\.}\" in {/,/^};/d" /opt/configs/bind/conf/defaults/named.reverse.conf
		done
	fi

	# installs older than this feature: named.conf has no include yet
	for c in /etc/named.conf /etc/bind/named.conf ; do
		[ -f "${c}" ] || continue
		grep -q 'named.reverse.conf' "${c}" || continue
		grep -q 'named.custom.conf' "${c}" || echo "include \"${INC}\";" >> "${c}"
	done

	if [ "$1" != "--no-reload" ] ; then
		if command -v named-checkconf >/dev/null 2>&1 && [ -f /etc/named.conf ] ; then
			named-checkconf /etc/named.conf >/dev/null 2>&1 || die "BIND configuration error: $(named-checkconf /etc/named.conf 2>&1 | head -2 | tr '\n' ' ')"
		fi

		rndc reload >/dev/null 2>&1 || systemctl restart named >/dev/null 2>&1 || systemctl restart bind9 >/dev/null 2>&1
	fi

	echo "OK=applied"
}

cmd_save() {
	local z="$1" f="$2"
	local res
	res="$(cmd_check "${z}" "${f}")" || { echo "${res}" ; exit 1 ; }

	mkdir -p "${STORE}"
	chmod 700 "${STORE}"
	tr -d '\r' < "${f}" > "${STORE}/${z}.zone"
	chmod 600 "${STORE}/${z}.zone"

	cmd_apply
}

cmd_delete() {
	valid_zone "$1" || die "invalid zone"
	rm -f "${STORE}/$1.zone"
	cmd_apply
}

case "$1" in
	list)   cmd_list ;;
	check)  cmd_check "$2" "$3" ;;
	save)   cmd_save "$2" "$3" ;;
	delete) cmd_delete "$2" ;;
	apply)  cmd_apply "$2" ;;
	*)      echo "usage: $0 list|check|save|delete|apply" ; exit 2 ;;
esac
