#!/bin/bash
[ -z "$BASH_VERSION" ] && exec /bin/bash "$0" "$@"

#    KloxoNext - small sanity fixes run before install/update.
#
#    Older Kloxo versions added 'exclude=mysql* mariadb*' and 'sslverify=false'
#    to /etc/yum.conf, ran 'chmod 777 /var/run' and forced dhclient on every
#    interface. KloxoNext reverts those changes instead of applying them.

echo ">>> fix-urgent <<<"

. /script/os.inc

if os_is_el ; then
	for f in /etc/yum.conf /etc/dnf/dnf.conf ; do
		[ -f "${f}" ] || continue
		sed -i '/^sslverify=false$/d' "${f}"
		sed -i '/^exclude=mysql\* mariadb\*$/d' "${f}"
	done
fi

# sudo is needed by the panel (lxlabs runs helpers through it)
command -v sudo >/dev/null 2>&1 || pkg_install sudo

# old Kloxo made /var/run world writable
[ "$(stat -c %a /run 2>/dev/null)" == "777" ] && chmod 755 /run

# chkconfig shim (Ubuntu) / historical /usr/bin path used by cron jobs
if ! command -v chkconfig >/dev/null 2>&1 ; then
	install -m 0755 /usr/local/lxlabs/kloxo/file/linux/compat/chkconfig /usr/sbin/chkconfig
fi
[ -e /usr/bin/chkconfig ] || ln -s "$(command -v chkconfig)" /usr/bin/chkconfig

# Stop annoying journald wall messages
sed -i 's/^#ForwardToWall=yes/ForwardToWall=no/g' /etc/systemd/journald.conf

sh /script/fix-limits > /dev/null 2>&1
