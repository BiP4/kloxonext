#!/bin/bash
[ -z "$BASH_VERSION" ] && exec /bin/bash "$0" "$@"

#    KloxoNext - select the PHP used by the panel itself (phpXYs) and install
#    the panel services (nginx + php-fpm + wrapper).

. /script/os.inc
. /script/php-native.inc

if [ "$1" == "--help" ] || [ "$1" == "-h" ] ; then
	echo
	echo " ------------------------------------------------------------------------------"
	echo "  format: sh $0 [phpXYs]   (default: php${PHP_PANEL_BRANCH}s or newer)"
	echo " ------------------------------------------------------------------------------"
	echo
	exit
fi

INIT_DIR="${KLOXO_PATH}/init"

[ -f "${INIT_DIR}/php_active" ] && mv -f "${INIT_DIR}/php_active" "${INIT_DIR}/kloxo_php_active"

if [ -n "$1" ] ; then
	base_name="$1"
elif [ -f "${INIT_DIR}/kloxo_php_active" ] ; then
	base_name="$(tr -d ' \n' < "${INIT_DIR}/kloxo_php_active")"
fi

# Panel never runs on anything older than PHP_PANEL_MIN_BRANCH
if [ -z "${base_name}" ] || [ "${base_name:3:2}" -lt "${PHP_PANEL_MIN_BRANCH}" ] 2>/dev/null ; then
	base_name="php$(php_panel_branch)s"
fi

if [ ! -f "/opt/${base_name}/custom/php-cli.sh" ] ; then
	echo "File: '/opt/${base_name}/custom/php-cli.sh' not exists. Installing..."
	sh /script/phpm-installer "${base_name}" -y
fi

echo "${base_name}" > "${INIT_DIR}/kloxo_php_active"

[ -f "/opt/${base_name}/custom/custom.php.ini" ] && cp -f "/opt/${base_name}/custom/custom.php.ini" "/opt/${base_name}/custom/php.ini"

chown -R root:root "/opt/${base_name}"

rm -f /usr/bin/lphp.exe /usr/bin/lxphp.exe
ln -sf "/opt/${base_name}/custom/php-cli.sh" /usr/bin/lphp.exe
ln -sf "/opt/${base_name}/custom/php-cli.sh" /usr/bin/lxphp.exe

rm -f "${OS_SYSTEMD_DIR}/kloxo.service" /etc/rc.d/init.d/kloxo

for i in web php wrap ; do
	if [ -f "${INIT_DIR}/custom.kloxo-${i}.service" ] ; then
		cp -f "${INIT_DIR}/custom.kloxo-${i}.service" "/etc/systemd/system/kloxo-${i}.service"
	else
		cp -f "${INIT_DIR}/kloxo-${i}.service" "/etc/systemd/system/kloxo-${i}.service"
	fi

	chmod 0644 "/etc/systemd/system/kloxo-${i}.service"
	# remove units installed by older Kloxo versions
	rm -f "${OS_SYSTEMD_DIR}/kloxo-${i}.service" "/etc/rc.d/init.d/kloxo-${i}"
done

systemctl daemon-reload

for i in web php wrap ; do
	systemctl enable "kloxo-${i}" >/dev/null 2>&1
done

echo "Execute fixlxphpexe for ${base_name}..."

# daily third-party apps / PHP update
cp -f "${INIT_DIR}/kloxo-thirdparty-update.service" /etc/systemd/system/
cp -f "${INIT_DIR}/kloxo-thirdparty-update.timer" /etc/systemd/system/
cp -f "${INIT_DIR}/kloxo-apps.service" /etc/systemd/system/
systemctl daemon-reload
systemctl enable --now kloxo-thirdparty-update.timer >/dev/null 2>&1
systemctl enable kloxo-apps >/dev/null 2>&1

# binaries used by the panel units
ln -sfn "/opt/${base_name}/custom/php-fpm.sh" "${INIT_DIR}/kloxo-phpcgi"
mkdir -p "${KLOXO_PATH}/log" "${KLOXO_PATH}/session" "${INIT_DIR}/tmp"

# the panel nginx needs a certificate before the first cleanup runs
sh /script/ssl-default-generate
for e in key crt ca pem ; do
	[ -s "${KLOXO_PATH}/etc/program.${e}" ] || cp -f "${KLOXO_PATH}/etc/ssl-default/default.${e}" "${KLOXO_PATH}/etc/program.${e}"
done
chmod 600 "${KLOXO_PATH}/etc/program.key" "${KLOXO_PATH}/etc/program.pem"
