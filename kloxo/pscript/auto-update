#!/bin/bash
[ -z "$BASH_VERSION" ] && exec /bin/bash "$0" "$@"

#    KloxoNext - daily maintenance run by kloxo-thirdparty-update.timer
#
#    1. security/bugfix updates of the installed PHP branches (same major.minor)
#       - disable with: touch /usr/local/lxlabs/kloxo/etc/flag/no-auto-update-php.flg
#    2. optional: install a newly released PHP branch as phpXYm
#       - enable with:  touch /usr/local/lxlabs/kloxo/etc/flag/auto-install-new-php.flg
#    3. latest upstream phpMyAdmin / Roundcube / SnappyMail
#    4. third-party apps switched to the newest PHP installed
#    5. KloxoNext itself from GitHub, only when the administrator enabled
#       "Automatic panel updates" on the panel Update page
#       (etc/flag/auto-update-panel.flg)

. /script/os.inc
. /script/php-native.inc

flag="${KLOXO_PATH}/etc/flag"

if [ ! -f "${flag}/no-auto-update-php.flg" ] ; then
	sh /script/phpm-updater
	sh /script/restart-php-fpm >/dev/null 2>&1
fi

if [ -f "${flag}/auto-install-new-php.flg" ] ; then
	latest="$(php_latest_available)"
	if [ -n "${latest}" ] && [ ! -d "/opt/php${latest}m" ] ; then
		echo "- New PHP branch $(php_dotted "${latest}") available, installing php${latest}m"
		sh /script/phpm-installer "php${latest}m"
		php_set_branch "${latest}"
		sh /script/fixphp >/dev/null 2>&1
	fi
fi

sh /script/thirdparty-update

if [ -f "${flag}/auto-update-panel.flg" ] ; then
	# separate unit: the cleanup restarts panel services
	systemctl start --no-block kloxo-panel-update.service
fi
