#!/bin/bash
[ -z "$BASH_VERSION" ] && exec /bin/bash "$0" "$@"

#    KloxoNext - httpry (HTTP request logger) is optional and only installed
#    when the repositories of this distribution provide it.

. /script/os.inc

if ! pkg_available httpry ; then
	echo "- httpry is not packaged for ${OS_ID} ${OS_VERSION}; skipped"
	exit 0
fi

pkg_install httpry
cp -f /opt/configs/httpry/etc/logrotate.d/httpry /etc/logrotate.d/httpry 2>/dev/null
systemctl enable --now httpry >/dev/null 2>&1
