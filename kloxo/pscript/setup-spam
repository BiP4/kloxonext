#!/bin/bash
[ -z "$BASH_VERSION" ] && exec /bin/bash "$0" "$@"
#
#    KloxoNext - spam filtering for the Postfix + Dovecot virtual mail
#
#    Messages are checked while Dovecot delivers them (LMTP): a global Sieve
#    script passes each message through SpamAssassin (spamc -> spamd) or
#    Bogofilter, which only add headers (X-Spam-Level / X-Spam-Flag or
#    X-Bogosity). The account's own Sieve script, generated by the panel
#    (KnMail), then applies its settings: on/off, score, subject tag, white /
#    black list and what to do with spam (Junk folder, keep, delete).
#    Moving a message into Junk teaches the filter "spam", moving it out of
#    Junk teaches "ham" (IMAPSieve).
#
#      setup-spam [apply [engine]]   configure everything (engine: spamassassin |
#                                    bogofilter | none, default: the panel's driver)
#      setup-spam set KEY=VALUE...   change settings (see spam.conf), then apply
#      setup-spam status             KEY=VALUE lines for the panel
#      setup-spam update-rules       download the newest SpamAssassin rules (sa-update)
#      setup-spam test               run a GTUBE test message through the filter
#
#    Files: /etc/dovecot/kloxo/spam/  spam.conf, *.sieve, bin/ (filter + learn)
#           /var/lib/kloxo-spam/      Bayes database / Bogofilter word list (vmail)

. /script/os.inc

K="${KLOXO_PATH}"
D=/etc/dovecot/kloxo/spam
CONF="${D}/spam.conf"
DATA=/var/lib/kloxo-spam
VMAIL=vmail

if os_is_el ; then
	SA_DIR=/etc/mail/spamassassin
	SPAMD=spamassassin
	SA_TIMER=sa-update.timer
else
	SA_DIR=/etc/spamassassin
	SPAMD=spamd
	SA_TIMER=spamassassin-maintenance.timer
fi

# ------------------------------------------------------------------ settings

# defaults, then the saved values
ENGINE=bogofilter
MAX_KB=1024
SA_NETWORK=on
SA_AUTOLEARN=on
SA_AUTOUPDATE=on
BOGO_SPAM_CUTOFF=0.99
BOGO_HAM_CUTOFF=0.45
LEARN_FROM_JUNK=on

load_conf() {
	local k v

	[[ -f "${CONF}" ]] || return 0

	while IFS='=' read -r k v ; do
		case "${k}" in
			ENGINE|MAX_KB|SA_NETWORK|SA_AUTOLEARN|SA_AUTOUPDATE|BOGO_SPAM_CUTOFF|BOGO_HAM_CUTOFF|LEARN_FROM_JUNK)
				valid "${k}" "${v}" && printf -v "${k}" '%s' "${v}" ;;
		esac
	done < "${CONF}"
}

valid() {
	case "$1" in
		ENGINE)           [[ "$2" =~ ^(spamassassin|bogofilter|none)$ ]] ;;
		MAX_KB)           [[ "$2" =~ ^[0-9]{2,6}$ ]] && (( $2 >= 64 && $2 <= 102400 )) ;;
		SA_NETWORK|SA_AUTOLEARN|SA_AUTOUPDATE|LEARN_FROM_JUNK)
		                  [[ "$2" =~ ^(on|off)$ ]] ;;
		BOGO_SPAM_CUTOFF|BOGO_HAM_CUTOFF)
		                  [[ "$2" =~ ^0(\.[0-9]{1,4})?$|^1(\.0{1,4})?$ ]] ;;
		*)                return 1 ;;
	esac
}

save_conf() {
	mkdir -p "${D}"
	cat > "${CONF}.tmp" <<-EOF
	# KloxoNext spam filter - written by /script/setup-spam (Mail > Spam Filter)
	ENGINE=${ENGINE}
	MAX_KB=${MAX_KB}
	SA_NETWORK=${SA_NETWORK}
	SA_AUTOLEARN=${SA_AUTOLEARN}
	SA_AUTOUPDATE=${SA_AUTOUPDATE}
	BOGO_SPAM_CUTOFF=${BOGO_SPAM_CUTOFF}
	BOGO_HAM_CUTOFF=${BOGO_HAM_CUTOFF}
	LEARN_FROM_JUNK=${LEARN_FROM_JUNK}
	EOF
	chmod 0644 "${CONF}.tmp"
	mv -f "${CONF}.tmp" "${CONF}"
}

panel_engine() {
	sh /script/setdriver --server=localhost --class=spam 2>/dev/null | sed -n 's/^Driver for spam is //p' | tail -1
}

die() {
	echo "ERROR=$*"
	exit 1
}

# ------------------------------------------------------------------ helper programs (run as vmail)

write_bin() {
	mkdir -p "${D}/bin"

	# filter: message on stdin -> message with the spam headers on stdout
	cat > "${D}/bin/kn-spam-filter" <<-'EOF'
	#!/bin/bash
	# KloxoNext - called by Dovecot (Sieve "filter") for every delivered message.
	# Only accounts with the spam filter on have ~/.kloxo-spam (written by the panel).
	CONF=/etc/dovecot/kloxo/spam/spam.conf

	[[ -n "${HOME}" && -f "${HOME}/.kloxo-spam" && -r "${CONF}" ]] || exec cat

	ENGINE=$(sed -n 's/^ENGINE=//p' "${CONF}")
	MAX_KB=$(sed -n 's/^MAX_KB=//p' "${CONF}")
	SPAM_CUT=$(sed -n 's/^BOGO_SPAM_CUTOFF=//p' "${CONF}")
	HAM_CUT=$(sed -n 's/^BOGO_HAM_CUTOFF=//p' "${CONF}")

	case "${ENGINE}" in
		spamassassin)
			# spamd down or message too big: the message passes unchanged
			exec /usr/bin/spamc -s $(( ${MAX_KB:-1024} * 1024 )) ;;
		bogofilter)
			exec /usr/bin/bogofilter -p -e -d /var/lib/kloxo-spam/bogofilter -o "${SPAM_CUT:-0.99},${HAM_CUT:-0.45}" ;;
		*)
			exec cat ;;
	esac
	EOF

	# learn: message on stdin, $1 = spam | ham
	cat > "${D}/bin/kn-spam-learn" <<-'EOF'
	#!/bin/bash
	# KloxoNext - teach the filter one message (stdin): kn-spam-learn spam|ham
	# Called by Dovecot (IMAPSieve: moved into / out of Junk) and by the panel.
	CONF=/etc/dovecot/kloxo/spam/spam.conf

	case "$1" in
		spam|ham) ;;
		*) exit 64 ;;
	esac

	ENGINE=$(sed -n 's/^ENGINE=//p' "${CONF}" 2>/dev/null)

	case "${ENGINE}" in
		spamassassin)
			# sa-learn needs a second or two: done in the background, the mail client does not wait
			tmp=$(mktemp "${TMPDIR:-/tmp}/kn-learn.XXXXXX") || exit 0
			cat > "${tmp}"
			setsid bash -c '/usr/bin/sa-learn --"$1" "$2" >/dev/null 2>&1; rm -f "$2"' kn-learn "$1" "${tmp}" </dev/null >/dev/null 2>&1 &
			;;
		bogofilter)
			if [[ "$1" == "spam" ]] ; then
				/usr/bin/bogofilter -d /var/lib/kloxo-spam/bogofilter -s
			else
				/usr/bin/bogofilter -d /var/lib/kloxo-spam/bogofilter -n
			fi
			;;
		*)
			cat >/dev/null ;;
	esac

	exit 0
	EOF

	chmod 0755 "${D}/bin/kn-spam-filter" "${D}/bin/kn-spam-learn"
}

# ------------------------------------------------------------------ Sieve scripts

write_sieve() {
	cat > "${D}/filter.sieve" <<-'EOF'
	# KloxoNext - adds the spam headers; the account's own script files the message
	require ["vnd.dovecot.filter"];

	filter "kn-spam-filter";
	EOF

	cat > "${D}/learn-spam.sieve" <<-'EOF'
	# KloxoNext - a message moved into Junk is spam
	require ["vnd.dovecot.pipe", "copy", "imapsieve"];

	pipe :copy "kn-spam-learn" ["spam"];
	EOF

	cat > "${D}/learn-ham.sieve" <<-'EOF'
	# KloxoNext - a message moved out of Junk (not to the Trash) is not spam
	require ["vnd.dovecot.pipe", "copy", "imapsieve", "environment", "variables"];

	if environment :matches "imap.mailbox" "*" {
	  set "mailbox" "${1}";
	}

	if string :is "${mailbox}" "Trash" {
	  stop;
	}

	pipe :copy "kn-spam-learn" ["ham"];
	EOF

	chmod 0644 "${D}"/*.sieve
}

# ------------------------------------------------------------------ Dovecot

dovecot24() {
	local dv
	dv="$(dovecot --version 2>/dev/null | awk '{print $1}')"
	[[ "$(printf '%s\n%s\n' 2.4 "${dv}" | sort -V | head -1)" == "2.4" ]]
}

write_dovecot() {
	local f="${D}/dovecot.conf.ext"

	if [[ "${ENGINE}" == "none" ]] ; then
		echo "# KloxoNext - spam filter off (Mail > Spam Filter)" > "${f}"
		return
	fi

	if dovecot24 ; then
		{
			echo "# KloxoNext - spam filter (generated by /script/setup-spam - do not edit)"
			cat <<-EOF
			sieve_plugins {
			  sieve_extprograms = yes
			  sieve_imapsieve = yes
			}
			sieve_extensions {
			  editheader = yes
			}
			sieve_global_extensions {
			  vnd.dovecot.filter = yes
			  vnd.dovecot.pipe = yes
			  vnd.dovecot.environment = yes
			}
			sieve_filter_bin_dir = ${D}/bin
			sieve_pipe_bin_dir = ${D}/bin

			protocol lmtp {
			  sieve_script kloxo_spam_filter {
			    type = before
			    path = ${D}/filter.sieve
			  }
			}
			EOF

			if [[ "${LEARN_FROM_JUNK}" == "on" ]] ; then
				cat <<-EOF

				protocol imap {
				  mail_plugins {
				    imap_sieve = yes
				  }
				}
				mailbox Junk {
				  sieve_script kloxo_learn_spam {
				    type = before
				    cause = copy
				    path = ${D}/learn-spam.sieve
				  }
				}
				imapsieve_from Junk {
				  sieve_script kloxo_learn_ham {
				    type = before
				    cause = copy
				    path = ${D}/learn-ham.sieve
				  }
				}
				EOF
			fi
		} > "${f}"
	else
		{
			echo "# KloxoNext - spam filter (generated by /script/setup-spam - do not edit)"
			echo "plugin {"
			echo "  sieve_plugins = sieve_extprograms sieve_imapsieve"
			echo "  sieve_extensions = +editheader"
			echo "  sieve_global_extensions = +vnd.dovecot.filter +vnd.dovecot.pipe +vnd.dovecot.environment"
			echo "  sieve_filter_bin_dir = ${D}/bin"
			echo "  sieve_pipe_bin_dir = ${D}/bin"
			echo "  sieve_before = ${D}/filter.sieve"

			if [[ "${LEARN_FROM_JUNK}" == "on" ]] ; then
				echo "  imapsieve_mailbox1_name = Junk"
				echo "  imapsieve_mailbox1_causes = COPY"
				echo "  imapsieve_mailbox1_before = file:${D}/learn-spam.sieve"
				echo "  imapsieve_mailbox2_name = *"
				echo "  imapsieve_mailbox2_from = Junk"
				echo "  imapsieve_mailbox2_causes = COPY"
				echo "  imapsieve_mailbox2_before = file:${D}/learn-ham.sieve"
			fi

			echo "}"

			if [[ "${LEARN_FROM_JUNK}" == "on" ]] ; then
				# \$mail_plugins here already holds the imap list of 99-kloxonext.conf
				echo "protocol imap {"
				echo "  mail_plugins = \$mail_plugins imap_sieve"
				echo "}"
			fi
		} > "${f}"
	fi

	chmod 0644 "${f}"
}

# ------------------------------------------------------------------ engines

setup_spamassassin() {
	command -v spamc >/dev/null 2>&1 && command -v sa-learn >/dev/null 2>&1 || pkg_install_logical spamassassin
	command -v spamc >/dev/null 2>&1 || die "SpamAssassin could not be installed"

	mkdir -p "${DATA}/bayes"
	chown "${VMAIL}:${VMAIL}" "${DATA}/bayes"
	chmod 0700 "${DATA}/bayes"

	local net=0 al=1
	[[ "${SA_NETWORK}" == "on" ]] || net=1
	[[ "${SA_AUTOLEARN}" == "on" ]] || al=0

	mkdir -p "${SA_DIR}"
	rm -f "${SA_DIR}/kloxo.cf"

	# the subject tag is set per account by the panel (AlmaLinux ships '[SPAM]' here)
	if [[ -f "${SA_DIR}/local.cf" ]] ; then
		sed -i -E 's/^(rewrite_header[[:space:]]+Subject([[:space:]].*)?)$/# \1   # KloxoNext: the tag is set per mail account/' "${SA_DIR}/local.cf"
	fi

	# loaded after local.cf ('zz'): these values win
	cat > "${SA_DIR}/zz-kloxonext.cf" <<-EOF
	# KloxoNext - written by /script/setup-spam (Mail > Spam Filter), do not edit:
	# put own rules in local.cf

	# headers only: the account's Sieve script decides (score, subject tag, Junk folder)
	report_safe 0
	required_score 5.0

	# one database for every mail account (spamd and sa-learn run as '${VMAIL}')
	bayes_path ${DATA}/bayes/bayes
	bayes_file_mode 0600
	bayes_auto_learn ${al}

	# DNS block lists (RBL) and other network tests
	skip_rbl_checks ${net}
	EOF

	if ! spamassassin --lint >/tmp/kn-salint.log 2>&1 ; then
		echo "- WARNING: spamassassin --lint reported problems (see /tmp/kn-salint.log)"
	fi

	if os_is_el ; then
		# spamd as root changes to the user given by spamc ('vmail'); keep the stock options
		[[ -f /etc/sysconfig/spamassassin ]] || echo 'SPAMDOPTIONS="-c -m5 -H"' > /etc/sysconfig/spamassassin
	fi

	systemctl enable "${SPAMD}" >/dev/null 2>&1
	systemctl restart "${SPAMD}" || die "${SPAMD} did not start"

	if [[ "${SA_AUTOUPDATE}" == "on" ]] ; then
		systemctl enable --now "${SA_TIMER}" >/dev/null 2>&1
	else
		systemctl disable --now "${SA_TIMER}" >/dev/null 2>&1
	fi

	# first install: rules newer than the package, in the background (needs the internet)
	if [[ "${SA_AUTOUPDATE}" == "on" ]] && ! ls -d /var/lib/spamassassin/*/updates_spamassassin_org >/dev/null 2>&1 ; then
		systemd-run --quiet --collect --unit="kloxo-sa-update-$(date +%s)" /bin/bash /script/setup-spam update-rules >/dev/null 2>&1
	fi
}

setup_bogofilter() {
	command -v bogofilter >/dev/null 2>&1 || pkg_install bogofilter
	command -v bogofilter >/dev/null 2>&1 || die "Bogofilter could not be installed"

	mkdir -p "${DATA}/bogofilter"
	chown "${VMAIL}:${VMAIL}" "${DATA}/bogofilter"
	chmod 0700 "${DATA}/bogofilter"
}

stop_spamd() {
	systemctl disable --now "${SPAMD}" >/dev/null 2>&1
	systemctl disable --now "${SA_TIMER}" >/dev/null 2>&1
}

# ------------------------------------------------------------------ commands

apply() {
	local e="$1"

	[[ -n "${e}" ]] || e="$(panel_engine)"
	valid ENGINE "${e}" && ENGINE="${e}"

	mkdir -p "${D}" "${DATA}"
	chmod 0755 "${D}" "${DATA}"

	case "${ENGINE}" in
		spamassassin) setup_spamassassin ;;
		bogofilter)   setup_bogofilter ; stop_spamd ;;
		none)         stop_spamd ;;
	esac

	save_conf
	write_bin
	write_sieve
	write_dovecot

	# the include line of 99-kloxonext.conf (older installs: added here)
	local dc=/etc/dovecot/conf.d/99-kloxonext.conf
	if [[ -f "${dc}" ]] && ! grep -q 'kloxo/spam/dovecot.conf.ext' "${dc}" ; then
		sed -i "s#^!include_try conf.d/99-kloxonext-custom.conf.ext#!include_try ${D}/dovecot.conf.ext\n&#" "${dc}"
	fi

	if ! doveconf -n >/dev/null 2>/tmp/kn-doveconf.err ; then
		echo "- ERROR: Dovecot rejected the spam filter configuration:"
		cat /tmp/kn-doveconf.err
		echo "# KloxoNext - spam filter disabled: Dovecot rejected the configuration" > "${D}/dovecot.conf.ext"
	fi

	# Dovecot cannot save compiled scripts in a directory it cannot write: the
	# delivery script is compiled here (the IMAP ones only compile inside IMAP)
	rm -f "${D}"/*.svbin
	if grep -q 'sieve_' "${D}/dovecot.conf.ext" && command -v sievec >/dev/null 2>&1 ; then
		sievec "${D}/filter.sieve" >/tmp/kn-sievec.log 2>&1 || { echo "- WARNING: sievec filter.sieve:" ; cat /tmp/kn-sievec.log ; }
	fi

	systemctl reload-or-restart dovecot >/dev/null 2>&1

	# per-account files (~/.kloxo-spam) and Sieve rules
	(cd "${K}/httpdocs" && lxphp.exe ../bin/misc/mail-rebuild.php >/dev/null 2>&1)

	echo "- Spam filter: ${ENGINE}"
}

status() {
	echo "ENGINE=${ENGINE}"
	echo "MAX_KB=${MAX_KB}"
	echo "SA_NETWORK=${SA_NETWORK}"
	echo "SA_AUTOLEARN=${SA_AUTOLEARN}"
	echo "SA_AUTOUPDATE=${SA_AUTOUPDATE}"
	echo "BOGO_SPAM_CUTOFF=${BOGO_SPAM_CUTOFF}"
	echo "BOGO_HAM_CUTOFF=${BOGO_HAM_CUTOFF}"
	echo "LEARN_FROM_JUNK=${LEARN_FROM_JUNK}"

	if grep -q 'sieve_' "${D}/dovecot.conf.ext" 2>/dev/null && grep -q 'kloxo/spam/dovecot.conf.ext' /etc/dovecot/conf.d/99-kloxonext.conf 2>/dev/null ; then
		echo "DOVECOT=on"
	else
		echo "DOVECOT=off"
	fi

	if command -v spamassassin >/dev/null 2>&1 ; then
		echo "SA_VERSION=$(spamassassin -V 2>/dev/null | head -1 | awk '{print $3}')"
		echo "SPAMD=$(systemctl is-active "${SPAMD}" 2>/dev/null)"
		local u
		u="$(ls -d /var/lib/spamassassin/*/updates_spamassassin_org 2>/dev/null | tail -1)"
		[[ -n "${u}" ]] && echo "SA_RULES=$(date -r "${u}" '+%Y-%m-%d %H:%M')" || echo "SA_RULES=package"

		if [[ -f "${DATA}/bayes/bayes_toks" ]] ; then
			runuser -u "${VMAIL}" -- sa-learn --dump magic 2>/dev/null \
				| awk '$NF=="nspam"{print "SA_BAYES_SPAM="$3} $NF=="nham"{print "SA_BAYES_HAM="$3} $NF=="ntokens"{print "SA_BAYES_TOKENS="$3}'
		fi
	else
		echo "SA_VERSION="
	fi

	if command -v bogofilter >/dev/null 2>&1 ; then
		echo "BOGO_VERSION=$(bogofilter -V 2>&1 | head -1 | awk '{print $3}')"

		if [[ -f "${DATA}/bogofilter/wordlist.db" ]] ; then
			runuser -u "${VMAIL}" -- bogoutil -w "${DATA}/bogofilter" .MSG_COUNT 2>/dev/null \
				| awk '$1==".MSG_COUNT"{print "BOGO_SPAM="$2; print "BOGO_HAM="$3}'
		fi
	else
		echo "BOGO_VERSION="
	fi

	echo "ACCOUNTS_ON=$(find /home/vmail -mindepth 3 -maxdepth 3 -name .kloxo-spam 2>/dev/null | wc -l)"
}

update_rules() {
	command -v sa-update >/dev/null 2>&1 || die "SpamAssassin is not installed"

	sa-update -v 2>&1 | tail -5
	local rc=${PIPESTATUS[0]}

	# 0: updated, 1: nothing new
	if (( rc <= 1 )) ; then
		systemctl reload-or-restart "${SPAMD}" >/dev/null 2>&1
		[[ ${rc} == 0 ]] && echo "- Rules updated" || echo "- Rules already up to date"
	else
		die "sa-update failed (code ${rc})"
	fi
}

gtube_test() {
	local h
	h="$(mktemp -d)"
	touch "${h}/.kloxo-spam"
	chown -R "${VMAIL}:${VMAIL}" "${h}"

	printf '%s\n' "From: test@example.com" "To: postmaster@localhost" "Subject: KloxoNext spam filter test" "Message-ID: <kn-gtube-$$@localhost>" "" \
		"XJS*C4JDBQADN1.NSBN3*2IDNEN*GTUBE-STANDARD-ANTI-UBE-TEST-EMAIL*C.34X" "" \
		| runuser -u "${VMAIL}" -- env HOME="${h}" "${D}/bin/kn-spam-filter" \
		| sed -n '/^$/q;/^X-Spam-\(Flag\|Level\|Status\)\|^X-Bogosity/p' > "${h}/out"

	if [[ -s "${h}/out" ]] ; then
		cat "${h}/out"
	else
		echo "No spam headers were added (engine: ${ENGINE})."
	fi

	rm -rf "${h}"
}

load_conf

case "${1:-apply}" in
	apply)
		apply "$2"
		;;
	set)
		shift
		for kv in "$@" ; do
			k="${kv%%=*}"
			v="${kv#*=}"
			valid "${k}" "${v}" || die "invalid value: ${kv}"
			printf -v "${k}" '%s' "${v}"
		done
		save_conf
		apply "${ENGINE}"
		;;
	status)
		status
		;;
	update-rules)
		update_rules
		;;
	test)
		gtube_test
		;;
	*)
		echo "Usage: $0 [apply [spamassassin|bogofilter|none] | set KEY=VALUE... | status | update-rules | test]"
		exit 64
		;;
esac
