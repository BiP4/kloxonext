#!/bin/bash
[ -z "$BASH_VERSION" ] && exec /bin/bash "$0" "$@"

#    KloxoNext - remove the per-domain settings of RainLoop/SnappyMail
#      sh /script/del-rainloop-domains --domain=example.com

echo "*** Delete domain ini for RainLoop/SnappyMail webmail ***"

domain=""
for a in "$@" ; do
	case "${a}" in
		--domain=*) domain="${a#*=}" ;;
		-*)         ;;
		*)          domain="${a}" ;;
	esac
done

if [ -z "${domain}" ] ; then
	echo "Format: $0 --domain=<domainname>"
	exit 1
fi

for app in rainloop snappymail ; do
	for f in /home/kloxo/httpd/webmail/${app}/data/_data_*/_default_/domains/"${domain}".{ini,json} ; do
		[ -f "${f}" ] || continue
		rm -f "${f}"
		echo "- ${app}: '$(basename "${f}")' deleted"
	done
done
