#!/bin/bash
[ -z "$BASH_VERSION" ] && exec /bin/bash "$0" "$@"

. /script/os.inc
. /script/php-native.inc

if [ "$1" == "--help" ] || [ "$#" == 0 ] ; then
	echo
	echo " ------------------------------------------------------------------------------"
	echo "  format: sh $0 <phpXYm|phpXYs> [--purge]"
	echo " ------------------------------------------------------------------------------"
	echo "  --purge also removes the native packages when no other layout uses them"
	echo
	exit
fi

base_name="${1}"

if ! [[ "${base_name}" =~ ^php[0-9]{2}[ms]$ ]] ; then
	echo "* WARNING: only for phpXYm or phpXYs"
	exit 1
fi

. /script/counter-start.inc

xy="${base_name:3:2}"

echo "- Remove ${base_name}-fpm service"
systemctl disable --now "${base_name}-fpm" >/dev/null 2>&1
rm -f "${OS_SYSTEMD_DIR}/${base_name}-fpm.service" "/etc/systemd/system/${base_name}-fpm.service"
systemctl daemon-reload >/dev/null 2>&1

php_remove_compat_layout "${base_name}"

if [ "${2}" == "--purge" ] && [ ! -d "/opt/php${xy}m" ] && [ ! -d "/opt/php${xy}s" ] ; then
	echo "- Remove native PHP $(php_dotted "${xy}") packages"
	# shellcheck disable=SC2046
	pkg_remove $(php_native_packages "${xy}")
fi

# keep the 'php' branch pointing to an existing version
php_set_branch "$(php_latest_installed)"

. /script/counter-end.inc
