#!/bin/bash
[ -z "$BASH_VERSION" ] && exec /bin/bash "$0" "$@"

#    KloxoNext - choose the PHP branch used by the panel (always php-fpm behind nginx)

. /script/os.inc
. /script/php-native.inc

if [ "$1" == "--help" ] || [ "$1" == "-h" ] ; then
	echo
	echo " ------------------------------------------------------------------------------"
	echo "  format: sh $0 [fpm] [phpXYs]     (default: php${PHP_PANEL_BRANCH}s)"
	echo " ------------------------------------------------------------------------------"
	echo
	exit
fi

# 'cgi' mode belonged to Hiawatha; nginx always talks to php-fpm
rm -f "${KLOXO_PATH}/init/kloxo_use_php-cgi"

echo 'lxlabs ALL=(ALL:ALL) NOPASSWD:/usr/local/lxlabs/kloxo' > /etc/sudoers.d/mount
chmod 0440 /etc/sudoers.d/mount

target="${2:-php${PHP_PANEL_BRANCH}s}"

sh /script/fixlxphpexe "${target}"
sh /script/restart -y
