#!/bin/bash
[ -z "$BASH_VERSION" ] && exec /bin/bash "$0" "$@"

#
#    KloxoNext - install one PHP branch for Kloxo
#
#    Same interface as the historical Kloxo script, but PHP now comes from the
#    distribution package manager (Remi on EL, ondrej/php or Ubuntu archive on
#    Ubuntu) and /opt/phpXY[m|s] is a symlink layout built on top of it.
#

. /script/os.inc
. /script/php-native.inc

echo "=== BEGIN phpm-installer ==="

if [ "$1" == "--help" ] || [ "$#" == 0 ] ; then
	echo
	echo " ------------------------------------------------------------------------------"
	echo "  format: sh $0 <phpXYm|phpXYs> [--force]"
	echo " ------------------------------------------------------------------------------"
	echo "  phpXYm/phpXYs"
	echo "      - phpXYm for 'multiple php' (domains)"
	echo "      - phpXYs for 'special php' (Kloxo panel)"
	echo "      - available on this server: $(for b in $(php_available_branches) ; do echo -n "php${b} " ; done)"
	echo "  --force"
	echo "      - re-create the layout even if already present"
	echo
	exit
fi

base_name="${1}"

if ! [[ "${base_name}" =~ ^php[0-9]{2}[ms]$ ]] ; then
	echo "* WARNING: only for phpXYm or phpXYs (XY = $(echo ${PHP_KNOWN_BRANCHES} | sed 's/ /, /g'))"
	exit 1
fi

xy="${base_name:3:2}"
main_path="/opt/${base_name}"
log="${main_path}/${base_name}_install.log"

mkdir -p "${main_path}"

. /script/counter-start.inc

{
	echo "=== BEGIN '${base_name}' install ($(date)) on ${OS_ID} ${OS_VERSION} ==="

	if ! php_native_installed "${xy}" || [ "${2}" == "-y" ] || [ "${2}" == "--force" ] ; then
		os_setup_repos
		php_native_install "${xy}"
	else
		echo "- PHP $(php_dotted "${xy}") already installed from packages"
	fi

	if ! php_native_installed "${xy}" ; then
		echo "- ERROR: PHP $(php_dotted "${xy}") is not provided by the repositories of ${OS_ID} ${OS_VERSION}"
		exit 1
	fi

	php_build_compat_layout "${base_name}"
	if os_is_el ; then php_neutralize_remi_httpd_conf "${xy}" ; fi
} 2>&1 | tee -a "${log}"

[ "${PIPESTATUS[0]}" != "0" ] && exit 1

sh /script/phpm-config-setup "${base_name}"

if [[ "${base_name}" == *m ]] ; then
	sh /script/enable-php-fpm
fi

. /script/counter-end.inc

echo "- See '${log}' for detail install process"
echo "- For config setup only, run 'sh /script/phpm-config-setup ${base_name}'"
echo "=== END phpm-installer ==="
