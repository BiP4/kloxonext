#!/bin/bash
[ -z "$BASH_VERSION" ] && exec /bin/bash "$0" "$@"

#    KloxoNext - select the PHP version used by the 'php' branch
#    (domains with 'PHP Selected' = --default--).
#    Accepts 'php84', 'php84m', '84' or nothing (= newest installed).

. /script/os.inc
. /script/php-native.inc

if [ "${1}" == "--help" ] ; then
	echo
	echo " ---------------------------------------------------------------------------"
	echo "  format: sh $0 [phpXY]"
	echo "  available: $(for b in $(php_available_branches) ; do echo -n "php${b} " ; done)"
	echo " ---------------------------------------------------------------------------"
	echo
	exit
fi

xy="$(echo "${1}" | tr -dc '0-9' | cut -c1-2)"
[ -z "${xy}" ] && xy="$(php_latest_installed)"
[ -z "${xy}" ] && xy="$(php_latest_available)"

[ -d "/opt/php${xy}m" ] || sh /script/phpm-installer "php${xy}m"

php_set_branch "${xy}"
sh /script/set-php-fpm php
