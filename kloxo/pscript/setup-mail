#!/bin/bash
[ -z "$BASH_VERSION" ] && exec /bin/bash "$0" "$@"

#    KloxoNext - configure Postfix + Dovecot (+ OpenDKIM) for virtual mail.
#    Idempotent: safe to run on every cleanup/update.
#
#      Postfix   virtual domains/mailboxes/aliases from /etc/postfix/kloxo/*
#                delivery to Dovecot LMTP, SASL auth through Dovecot,
#                ports 25, 587 (submission) and 465 (smtps)
#      Dovecot   IMAP/POP3 (+TLS), LMTP, Sieve, quota; users in /etc/dovecot/kloxo/users
#      OpenDKIM  signs outgoing mail for every domain with a key in /etc/opendkim/keys

. /script/os.inc

K="${KLOXO_PATH}"
host="$(hostname -f 2>/dev/null || hostname)"

echo "*** Configure Postfix + Dovecot ***"

command -v postconf >/dev/null 2>&1 || pkg_install_logical postfix
command -v dovecot >/dev/null 2>&1 || pkg_install_logical dovecot

# older Kloxo scripts deleted the postfix account (qmail-toaster era)
if ! getent passwd postfix >/dev/null ; then
	if os_is_debian ; then
		DEBIAN_FRONTEND=noninteractive apt-get -y -q install --reinstall postfix >/dev/null
	else
		dnf -y -q reinstall postfix >/dev/null
	fi
fi

os_compat_accounts

mkdir -p /home/vmail /etc/postfix/kloxo /etc/dovecot/kloxo
chown vmail:vmail /home/vmail
chmod 0750 /home/vmail

for m in virtual_domains virtual_mailboxes virtual_aliases ; do
	[ -f "/etc/postfix/kloxo/${m}" ] || echo "# generated by KloxoNext" > "/etc/postfix/kloxo/${m}"
	postmap "hash:/etc/postfix/kloxo/${m}"
done

touch /etc/dovecot/kloxo/users
chown root:dovecot /etc/dovecot/kloxo/users
chmod 0640 /etc/dovecot/kloxo/users

# --------------------------------------------------------------- Postfix

pc() { postconf -e "$1" ; }

pc "myhostname = ${host}"
pc "myorigin = \$myhostname"
pc "mydestination = localhost, localhost.localdomain"
pc "inet_interfaces = all"
pc "inet_protocols = all"
pc "mynetworks_style = host"

pc "virtual_mailbox_domains = hash:/etc/postfix/kloxo/virtual_domains"
pc "virtual_mailbox_maps = hash:/etc/postfix/kloxo/virtual_mailboxes"
pc "virtual_alias_maps = hash:/etc/postfix/kloxo/virtual_aliases"
pc "virtual_transport = lmtp:unix:private/dovecot-lmtp"

pc "smtpd_sasl_type = dovecot"
pc "smtpd_sasl_path = private/auth"
pc "smtpd_sasl_auth_enable = no"
pc "smtpd_tls_cert_file = ${K}/etc/program.pem"
pc "smtpd_tls_key_file = ${K}/etc/program.pem"
pc "smtpd_tls_security_level = may"
pc "smtpd_tls_auth_only = yes"
pc "smtpd_tls_mandatory_protocols = >=TLSv1.2"
pc "smtp_tls_security_level = may"
pc "smtp_tls_CAfile = ${OS_CA_BUNDLE}"

pc "smtpd_helo_required = yes"
pc "disable_vrfy_command = yes"
pc "smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination"
pc "smtpd_recipient_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination"
pc "message_size_limit = 52428800"
pc "mailbox_size_limit = 0"

# submission (587, STARTTLS) and smtps (465, implicit TLS) - authenticated users only
for svc in submission smtps ; do
	postconf -M "${svc}/inet=${svc} inet n - n - - smtpd"
	postconf -P "${svc}/inet/syslog_name=postfix/${svc}"
	postconf -P "${svc}/inet/smtpd_sasl_auth_enable=yes"
	postconf -P "${svc}/inet/smtpd_client_restrictions=permit_sasl_authenticated,reject"
	postconf -P "${svc}/inet/smtpd_relay_restrictions=permit_sasl_authenticated,reject"
	postconf -P "${svc}/inet/smtpd_recipient_restrictions=permit_sasl_authenticated,reject"
	postconf -P "${svc}/inet/milter_macro_daemon_name=ORIGINATING"
done
postconf -P "submission/inet/smtpd_tls_security_level=encrypt"
postconf -P "smtps/inet/smtpd_tls_wrappermode=yes"

# 'Delete' catch-all target
if ! grep -q '^devnull:' /etc/aliases 2>/dev/null ; then
	echo 'devnull: /dev/null' >> /etc/aliases
fi
newaliases >/dev/null 2>&1

# --------------------------------------------------------------- OpenDKIM

if [ -x /usr/sbin/opendkim ] ; then
	mkdir -p /etc/opendkim/keys
	chown -R opendkim:opendkim /etc/opendkim/keys 2>/dev/null

	conf=/etc/opendkim.conf
	sock="inet:8891@127.0.0.1"   # OpenDKIM syntax (Postfix uses inet:host:port)

	sed -i '/^# KloxoNext begin/,/^# KloxoNext end/d' "${conf}"
	sed -i -E 's/^(Mode|Socket|KeyTable|SigningTable|ExternalIgnoreList|InternalHosts|KeyFile|Selector|Domain)\b/#&/' "${conf}"
	cat >> "${conf}" <<-EOF
	# KloxoNext begin
	Mode                    sv
	Socket                  ${sock}
	KeyTable                refile:/etc/opendkim/KeyTable
	SigningTable            refile:/etc/opendkim/SigningTable
	ExternalIgnoreList      refile:/etc/opendkim/TrustedHosts
	InternalHosts           refile:/etc/opendkim/TrustedHosts
	# KloxoNext end
	EOF

	sh /script/fixmail-dkim >/dev/null 2>&1

	pc "milter_default_action = accept"
	pc "smtpd_milters = inet:127.0.0.1:8891"
	pc "non_smtpd_milters = inet:127.0.0.1:8891"
fi

# --------------------------------------------------------------- Dovecot

dv="$(dovecot --version 2>/dev/null | awk '{print $1}')"

if [ "$(printf '%s\n%s\n' 2.4 "${dv}" | sort -V | head -1)" == "2.4" ] ; then
	tpl="${K}/file/mail/dovecot-2.4.conf"
else
	tpl="${K}/file/mail/dovecot-2.3.conf"
fi

sed "s/__HOSTNAME__/${host}/g" "${tpl}" > /etc/dovecot/conf.d/99-kloxonext.conf

# only virtual users may log in (no PAM / system accounts)
sed -i 's/^!include auth-system.conf.ext/#!include auth-system.conf.ext/' /etc/dovecot/conf.d/10-auth.conf

if ! doveconf -n >/dev/null 2>/tmp/doveconf.err ; then
	echo "- ERROR: Dovecot configuration rejected:"
	cat /tmp/doveconf.err
fi

# --------------------------------------------------------------- maps + services

(cd "${K}/httpdocs" && lxphp.exe ../bin/misc/mail-rebuild.php)

for s in opendkim postfix dovecot ; do
	systemctl list-unit-files "${s}.service" >/dev/null 2>&1 || continue
	systemctl enable "${s}" >/dev/null 2>&1
	systemctl restart "${s}"
done

echo "- Mail: Postfix $(postconf -h mail_version), Dovecot ${dv}"
